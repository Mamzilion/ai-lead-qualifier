        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.model,\n  temperature: 0.2,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You qualify B2B leads for \" + $json.company_name + \", an AI automation agency. Answer ONLY with valid JSON, no markdown, in this exact format: {\\\"score\\\": number 0-100, \\\"category\\\": \\\"hot\\\" or \\\"warm\\\" or \\\"cold\\\", \\\"summary\\\": \\\"one sentence for the sales team\\\", \\\"reply_subject\\\": \\\"email subject\\\", \\\"reply_body\\\": \\\"short, warm, personalised email reply in the same language as the lead, signed \" + $json.company_name + \"\\\"}. Rules: hot = clear need and budget over $500. warm = clear need but small or unclear budget. cold = vague request.\"\n    },\n    {\n      role: \"user\",\n      content: JSON.stringify({\n        name: $json[\"Full name\"],\n        company: $json.Company,\n        budget: $json.Budget,\n        details: $json[\"Project details\"]\n      })\n    }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "389481eb-aff2-434e-ab8a-4fe054ac351a",
      "name": "AI Score lead",
      "credentials": {
        "httpHeaderAuth": {
          "id": "kNVrQoM33tetEoxx",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Récupérer le texte renvoyé par l'IA\nconst raw = $json.choices[0].message.content;\n\n// 2. Nettoyer : certains modèles entourent le JSON de ```json ... ```\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\n// 3. Convertir le texte en objet JavaScript\nlet ai;\ntry {\n  ai = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error('AI answer is not valid JSON: ' + raw);\n}\n\n// 4. Récupérer les données des nœuds précédents par leur nom\nconst lead = $('On form submission').item.json;\nconst config = $('Config').item.json;\n\n// 5. Tout regrouper dans un seul objet propre\nreturn {\n  name: lead['Full name'],\n  email: lead.Email,\n  company: lead.Company || '',\n  budget: lead.Budget,\n  details: lead['Project details'],\n  score: ai.score,\n  category: ai.category,\n  summary: ai.summary,\n  reply_subject: ai.reply_subject,\n  reply_body: ai.reply_body,\n  sales_email: config.sales_email,\n  company_name: config.company_name\n};"
      },
